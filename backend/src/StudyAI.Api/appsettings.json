    "MaxOutputTokens": 4096
  },
  "Storage": {
    "Provider": "Local",
    "RootPath": "storage/users",
    "R2": {
      "Endpoint": "",
      "Bucket": "",
      "AccessKeyId": "",
      "SecretAccessKey": ""
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
