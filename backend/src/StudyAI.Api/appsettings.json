    "MaxOutputTokens": 4096
  },
  "RateLimiting": {
    "AiPermitLimit": 20
  },
  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "Username": "",
    "Password": "",
    "FromAddress": "no-reply@edumind.local",
    "FromName": "EduMind AI",
    "FrontendBaseUrl": "http://127.0.0.1:5173",
    "UseSsl": true
  },
  "Gemini": {
    "ApiKey": "",
    "Model": "gemini-2.0-flash",
